# ==========================================
# FrontFix AI — Environment Configuration
# Team B: Frontend Support (Node.js & Express)
# ==========================================

# Server runtime mode & networking
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------
# LLM Model Configuration (Google Gemini)
# ------------------------------------------
# Replace with your genuine Google Gemini API key:
# https://aistudio.google.com/app/apikey
# Note: Placeholders like 'your_gemini_api_key_here' are treated as unconfigured
# and will safely run FrontFix in canonical verified knowledge mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: Alternative OpenAI-compatible Provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------
# Security & Access Control
# ------------------------------------------
# Comma-separated list of permitted web origins for CORS
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000,http://localhost:5173,https://adnanak8.github.io

# Client-side Privacy Shield Toggle
ENABLE_PRIVACY_SHIELD=true
