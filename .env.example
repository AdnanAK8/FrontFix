# ===================================================================
# FrontFix AI — Environment Configuration Template
# ===================================================================
# NOTE: Copy this file to .env and insert your real keys.
# .env is excluded from git and must NEVER be committed to GitHub.

# Server Host & Port
PORT=8000
HOST=127.0.0.1

# Allowed Frontend Origins for CORS (comma-separated list)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# Privacy Shield Data Loss Prevention (redacts Bearer JWTs, API keys, passwords)
ENABLE_PRIVACY_SHIELD=true

# AI Model (LLM) Integration
# When GEMINI_API_KEY is supplied, FrontFix AI explains errors using Gemini grounded in canonical knowledge.
# If no key is configured or the service fails, it falls back to verified canonical knowledge base.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Optional: OpenAI or Ollama local alternative
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
